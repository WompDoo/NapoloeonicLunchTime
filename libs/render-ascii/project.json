{
  "name": "render-ascii",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/render-ascii/src",
  "projectType": "library",
  "tags": ["type:renderer"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^default"],
      "options": {
        "commands": [
          "tsc -p {projectRoot}/tsconfig.lib.json --noEmit",
          "tsc -p {projectRoot}/tsconfig.spec.json --noEmit"
        ],
        "parallel": false
      }
    }
  }
}
